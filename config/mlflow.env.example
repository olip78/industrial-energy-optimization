# Copy this file to .env, fill in the values that apply, then run: source .env
# Never commit .env: it can contain access credentials.

# A local MLflow server for development uses this URI.
export MLFLOW_TRACKING_URI="http://127.0.0.1:5000"
export MLFLOW_EXPERIMENT_NAME="pv-day-ahead"

# For a protected remote tracking server, uncomment ONE authentication method.
# export MLFLOW_TRACKING_USERNAME="your-user-name"
# export MLFLOW_TRACKING_PASSWORD="your-password-or-access-token"
# export MLFLOW_TRACKING_TOKEN="your-bearer-token"
